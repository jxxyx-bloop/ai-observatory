# Derived — both rebuild in seconds. `data/` holds your own usage history and
# `dist/` the rendered report. Neither belongs in a public repo, and committing
# either by accident is the most likely way to publish something you did not
# mean to.
data/
dist/

# Credentials. The community layer stores its token under
# ~/.config/ai-observatory/, outside the repo — this covers the case where
# someone points it here anyway.
credentials.json
.env
*.pem
*.key

# Local overrides. Copy settings.json to settings.local.json to keep your own
# timezone/currency/plan out of your diffs.
settings.local.json

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

.DS_Store
Thumbs.db
.idea/
.vscode/
